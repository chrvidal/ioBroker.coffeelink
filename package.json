  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrvidal/ioBroker.coffeelink.git"
  },
  "bugs": {
    "url": "https://github.com/chrvidal/ioBroker.coffeelink/issues"
  },
  "homepage": "https://github.com/chrvidal/ioBroker.coffeelink#readme",
  "main": "main.js",
  "files": [
