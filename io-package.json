{
  "common": {
    "name": "coffeelink",
    "version": "0.0.1",
    "titleLang": {"en": "Coffee Link", "de": "Coffee Link"},
    "desc": {
      "en": "Read-only status and lifetime counters of De'Longhi Coffee Link machines",
      "de": "Lesender Status und Getränkezähler für De'Longhi-Coffee-Link-Kaffeemaschinen"
    },
    "authors": ["chrvidal"],
    "license": "MIT",
    "platform": "Javascript/Node.js",
    "mode": "daemon",
    "type": "misc-data",
    "compact": true,
    "enabled": false,
    "connectionType": "cloud",
    "dataSource": "poll",
    "adminUI": {"config": "json"},
    "dependencies": [{"js-controller": ">=7.0.7"}],
    "globalDependencies": [{"admin": ">=7.8.23"}],
    "readme": "https://github.com/chrvidal/ioBroker.coffeelink/blob/main/README.md",
    "news": {
      "0.0.1": {"en": "Initial read-only development version", "de": "Erste lesende Entwicklungsversion"}
    }
  },
  "native": {"email": "", "password": "", "pollInterval": 15},
  "encryptedNative": ["password"],
  "protectedNative": ["password"],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {"name": "Information"},
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {"name": "Coffee Link connection", "type": "boolean", "role": "indicator.connected", "read": true, "write": false, "def": false},
      "native": {}
    }
  ]
}
