{
  "i18n": true,
  "type": "panel",
  "items": {
    "introduction": {
      "type": "staticText",
      "text": "Read machine status and counters from Coffee Link.",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "email": {
      "type": "text",
      "label": "Coffee Link email",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "password": {
      "type": "password",
      "label": "Coffee Link password",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "pollInterval": {
      "type": "number",
      "label": "Polling interval (minutes)",
      "min": 5,
      "max": 1440,
      "step": 1,
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "lanEnabled": {
      "type": "checkbox",
      "label": "Enable LAN",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "lanNote": {
      "type": "staticText",
      "text": "LAN adds local statistics and controls for PrimaDonna Soul machines. Connecting may interrupt the Coffee Link app's local connection.",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "lanMachineIp": {
      "type": "text",
      "label": "Coffee machine IP address",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "bind": {
      "type": "text",
      "label": "ioBroker LAN IPv4 address",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "port": {
      "type": "number",
      "label": "LAN callback port",
      "min": 1024,
      "max": 65535,
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    }
  }
}
